# Public Vite env (shipped to the browser)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional alias if the project still uses the older anon key name:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put any of the following in this file or in any VITE_ variable:
# SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY
# Those are Edge Function secrets only (Supabase Dashboard → Edge Functions → Secrets).

# ---------------------------------------------------------------------------
# Edge Function secrets (set in Supabase, not here)
# ---------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY — provided by the platform
# RESEND_API_KEY
# PUBLIC_SITE_URL=https://your-production-domain
# SITE_URL=https://your-production-domain
# RESEND_FROM=MotiveScripts <hello@your-domain>
# SUPPORT_EMAIL=hello@your-domain
# STRIPE_SECRET_KEY=sk_test_...   # use sk_live_... only when going live, still not VITE_
# STRIPE_WEBHOOK_SECRET=whsec_...

# Apply versioned SQL in supabase/migrations/ (SQL Editor or `supabase db push`).
# See docs/database.md, docs/auth.md, docs/production-launch-checklist.md, docs/stripe-payments.md.
